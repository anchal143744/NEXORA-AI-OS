// Retail transactions reuse the existing scoped catalog, stock and invoice foundations.
model RetailSale {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  organizationId String @db.Uuid
  workspaceId String @db.Uuid
  saleKey String
  requestHash String
  currency String @db.VarChar(3)
  status String @default("DRAFT")
  total Decimal @db.Decimal(18, 4)
  costOfGoods Decimal @default(0) @db.Decimal(18, 4)
  invoiceId String @unique @db.Uuid
  createdBy String @db.Uuid
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lines RetailSaleLine[]
  returns RetailReturn[]
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdByUser User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  currencyRef Currency @relation(fields: [currency], references: [code], onDelete: Restrict)
  @@unique([tenantId, saleKey])
  @@index([tenantId, workspaceId, completedAt])
}
model RetailSaleLine {
  id String @id @default(uuid()) @db.Uuid
  saleId String @db.Uuid
  stockId String @db.Uuid
  quantity Decimal @db.Decimal(18, 4)
  returnedQuantity Decimal @default(0) @db.Decimal(18, 4)
  unitPrice Decimal @db.Decimal(18, 4)
  lineTotal Decimal @db.Decimal(18, 4)
  costOfGoods Decimal @default(0) @db.Decimal(18, 4)
  returnedCost Decimal @default(0) @db.Decimal(18, 4)
  returnedAmount Decimal @default(0) @db.Decimal(18, 4)
  sale RetailSale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  stock StockBalance @relation(fields: [stockId], references: [id], onDelete: Restrict)
  @@unique([saleId, stockId])
}
model RetailReturn {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  saleId String @db.Uuid
  returnKey String
  requestHash String
  amount Decimal @db.Decimal(18, 4)
  costOfGoods Decimal @db.Decimal(18, 4)
  reason String
  actorUserId String @db.Uuid
  lines Json
  createdAt DateTime @default(now())
  sale RetailSale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  @@unique([tenantId, returnKey])
}