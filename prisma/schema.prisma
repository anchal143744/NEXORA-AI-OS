model Tenant {
  retailSales RetailSale[]
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  status TenantStatus @default(PROVISIONING)
  planTier TenantPlanTier @default(FREE)
  countryCode String? @db.VarChar(2)
  primaryLocale String? @db.VarChar(12)
  dataRegion String?
  metadata Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  organizations Organization[]
  users User[]
  roles Role[]
  permissions Permission[]
  sessions Session[]
  auditLogs AuditLog[]
  activityLogs ActivityLog[]
  notifications Notification[]
  workflows Workflow[]
  workflowExecutions WorkflowExecution[]
  workflowDefinitions WorkflowDefinition[]
  workflowNodes WorkflowNode[]
  workflowEdges WorkflowEdge[]
  workflowApprovals WorkflowApproval[]
  workflowMetrics WorkflowMetric[]
  workflowAudits WorkflowAudit[]
  events Event[]
  integrations Integration[]
  apiKeys ApiKey[]
  subscriptions Subscription[]
  aiConversations AiConversation[]
  aiRecommendations AiRecommendation[]
  aiInsights AiInsight[]
  dashboards Dashboard[]
  modules BusinessModule[]
  securityFindings SecurityFinding[]
  @@index([status, planTier])
  @@index([countryCode])
  @@index([deletedAt])
}

model Organization {
  retailSales RetailSale[]
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  parentId String? @db.Uuid
  name String
  legalName String?
  registrationId String?
  countryCode String? @db.VarChar(2)
  industry String?
  metadata Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent Organization? @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children Organization[] @relation("OrganizationHierarchy")
  businesses Business[]
  workspaces Workspace[]
  teams Team[]
  memberships Membership[]
  billingAccounts BillingAccount[]
  @@unique([tenantId, name])
  @@index([tenantId, parentId])
  @@index([tenantId, countryCode])
  @@index([tenantId, deletedAt])
}

model Business {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  organizationId String @db.Uuid
  name String
  businessType String
  industry String
  countryCode String? @db.VarChar(2)
  teamSizeBand String?
  revenueBand String?
  goals Json @default("[]")
  operatingModel Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaces Workspace[]
  moduleSettings ModuleSetting[]
  kpiMetrics KpiMetric[]
  @@unique([tenantId, organizationId, name])
  @@index([tenantId, businessType, industry])
  @@index([tenantId, countryCode])
  @@index([tenantId, deletedAt])
}

