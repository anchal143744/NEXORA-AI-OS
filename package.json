{
  "name": "nexora-ai",
  "private": true,
  "version": "1.9.0-src.1",
  "description": "NEXORA AI global enterprise AI business operating system",
  "packageManager": "npm@12.2.1",
  "scripts": {
    "db:check": "node scripts/check-local-database.mjs",
    "db:initialize:local": "node scripts/initialize-owned-dev-database.mjs",
    "db:start:local": "node scripts/start-owned-dev-postgres.mjs",
    "retail:test": "node scripts/run-retail-tests.mjs",
    "retail:unit": "node --test tests/retail-money.test.mjs",
    "api:dev": "npm --workspace @nexora/api run start:dev",
    "api:build": "npm --workspace @nexora/api run build",
    "api:typecheck": "npm --workspace @nexora/api run typecheck",
    "web:dev": "npm --workspace @nexora/web run dev",
    "web:build": "npm --workspace @nexora/web run build",
    "web:typecheck": "npm --workspace @nexora/web run typecheck",
    "api:test": "node scripts/api-production-smoke-test.mjs",
    "api:e2e": "node scripts/api-e2e-health-check.mjs",
    "crm:rbac": "node scripts/crm-rbac-runtime-test.mjs",
    "v1:runtime": "node scripts/v1-core-runtime-test.mjs",
    "lint": "node scripts/enterprise-lint.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "api:benchmark": "node scripts/api-performance-benchmark.mjs",
    "api": "npm --workspace @nexora/api run start",
    "web:lint": "npm --workspace @nexora/web run lint",
    "web:smoke": "node scripts/web-production-smoke-test.mjs",
    "web:v1:smoke": "node scripts/frontend-v1-smoke-audit.mjs",
    "web:rc1": "node scripts/web-rc1-workflow-audit.mjs",
    "web:lc1": "node scripts/web-lc1-integration-audit.mjs",
    "web:gm": "node scripts/web-gold-master-audit.mjs",
    "staging:seed": "node scripts/staging-demo-seed.mjs",
    "staging:e2e": "node scripts/staging-e2e-user-journey.mjs",
    "staging:load": "node scripts/staging-load-test.mjs",
    "web:src": "node scripts/staging-release-candidate-audit.mjs",
    "production:launch-gate": "node scripts/production-launch-gate.mjs",
    "dev": "node scripts/dev-start.mjs",
    "setup": "npm install && npx prisma generate",
    "typecheck": "npm run api:typecheck && npm run web:typecheck",
    "build": "npm run api:build && npm run web:build",
    "test": "npm run api:test && npm run jwt:security && npm run web:smoke && npm run web:v1:smoke",
    "jwt:security": "node scripts/jwt-security-test.mjs",
    "prisma:generate": "npx prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "npx prisma migrate deploy --schema prisma/schema.prisma",
    "desktop:prepare": "npm run desktop:signing:check && npm run desktop:stop && npm run api:build && npm run web:build && powershell -NoProfile -NonInteractive -File scripts/desktop/install-desktop.ps1 -NoInstall",
    "desktop:install": "powershell -NoProfile -NonInteractive -File scripts/desktop/install-desktop.ps1",
    "desktop:signing:check": "powershell -NoProfile -NonInteractive -File scripts/desktop/check-signing-readiness.ps1",
    "desktop:trust": "powershell -NoProfile -NonInteractive -File scripts/desktop/check-desktop-trust.ps1",
    "desktop:start": "node scripts/desktop-launch.mjs",
    "desktop:stop": "node scripts/desktop-stop.mjs",
    "desktop:backup": "node scripts/desktop-backup.mjs",
    "mail:check": "node scripts/check-mail-config.mjs",
    "desktop:sdk": "powershell -NoProfile -NonInteractive -File scripts/desktop/prepare-webview2.ps1",
    "desktop:signing:tools": "powershell -NoProfile -NonInteractive -File scripts/desktop/prepare-signing-tools.ps1",
    "desktop:release": "npm run desktop:signing:check && npm run desktop:stop && npm run build && powershell -NoProfile -NonInteractive -File scripts/desktop/build-windows-release.ps1",
    "desktop:package:test": "powershell -NoProfile -NonInteractive -File scripts/desktop/build-windows-release.ps1 -DevelopmentBuild",
    "retail:ui:test": "node scripts/run-retail-tests.mjs --ui",
    "retail:ui:fixture:test": "node scripts/run-retail-tests.mjs --ui-lifecycle-only",
    "retail:ui:session": "node scripts/run-retail-tests.mjs --ui-only-session",
    "retail:ui:recover": "node scripts/recover-disposable-ui-source.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3"
  },
  "overrides": {
    "postcss@8.4.31": "8.5.31",
    "js-yaml@>=4 <5": "4.3.2",
    "js-yaml@>=5 <6": "5.4.1",
    "deepmerge-ts@7.1.5": "8.0.2",
    "postcss-selector-parser@>=6 <7": "7.1.7",
    "multer@2.4.0": "2.5.0",
    "body-parser@2.3.0": "2.4.0",
    "fast-uri@3.1.8": "3.1.9"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
