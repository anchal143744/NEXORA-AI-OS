# Public setup template: replace placeholders privately; use a new disposable development database.
NODE_ENV=development
PORT=4000
API_PREFIX=api
APP_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

POSTGRES_PORT=5433
DATABASE_URL=postgresql://nexora_dev:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5433/nexora_public_dev?schema=public
DIRECT_URL=postgresql://nexora_dev:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5433/nexora_public_dev?schema=public
SHADOW_DATABASE_URL=postgresql://nexora_dev:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5433/nexora_public_shadow?schema=public

JWT_SECRET=replace-with-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-another-32-plus-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=replace-with-cookie-secret

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_PREFIX=nexora

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nexora-local
S3_ACCESS_KEY_ID=REPLACE_WITH_LOCAL_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_LOCAL_SECRET_KEY

OPENAI_API_KEY=
NEXORA_AI_DRAFTS_ENABLED=false
OPENAI_MODEL=
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
EMAIL_DELIVERY_ENABLED=false
# Plain SMTP is permitted only for an explicitly enabled loopback test mailbox.
SMTP_ALLOW_INSECURE_LOCAL=false
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@nexora.local
RESEND_API_KEY=
SENDGRID_API_KEY=

OTEL_SERVICE_NAME=nexora-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
METRICS_ENABLED=true

RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

NEXT_PUBLIC_API_URL=/api
NEXORA_API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
