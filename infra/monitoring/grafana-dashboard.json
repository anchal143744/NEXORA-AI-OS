{
  "title": "NEXORA Production Readiness",
  "tags": [
    "nexora",
    "production",
    "launch-readiness"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "API p95 Latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "API Error Rate",
      "targets": [
        {
          "expr": "rate(http_request_errors_total[5m]) / rate(http_requests_total[5m])"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue Depth",
      "targets": [
        {
          "expr": "bullmq_waiting_jobs"
        }
      ]
    },
    {
      "type": "stat",
      "title": "AI Runtime Failures",
      "targets": [
        {
          "expr": "rate(ai_execution_failures_total[5m])"
        }
      ]
    }
  ]
}