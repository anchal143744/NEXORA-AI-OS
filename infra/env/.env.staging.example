NODE_ENV=staging
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
DATABASE_URL=postgresql://nexora:replace-with-managed-secret@nexora-postgres:5432/nexora_staging?schema=public
REDIS_URL=redis://nexora-redis:6379
JWT_ACCESS_SECRET=replace-with-managed-secret
JWT_REFRESH_SECRET=replace-with-managed-secret
OPENAI_API_KEY=replace-with-managed-secret
S3_ENDPOINT=http://nexora-minio:9000
S3_BUCKET=nexora-staging
S3_ACCESS_KEY_ID=replace-with-managed-secret
S3_SECRET_ACCESS_KEY=replace-with-managed-secret
RATE_LIMIT_TENANT_WINDOW=60
RATE_LIMIT_TENANT_MAX=600
LOG_LEVEL=info
FEATURE_PUBLIC_BETA=false
